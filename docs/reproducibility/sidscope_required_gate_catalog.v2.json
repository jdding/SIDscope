{
  "schema": "sidscope.required_gate_catalog.v2",
  "title": "SIDScope 2.0 required local delivery gates",
  "policy": "All ten required same-source gates must pass. Linux support and its four-cell matrix are deferred by the project owner on 2026-10-08; this is a support-scope change, never a Linux PASS. Changing this frozen catalog requires a new format revision.",
  "gates": [
    {
      "gate_id": "full_cpu_test_suite",
      "binding": "catalog_command",
      "description": "Full CPU pytest suite on the clean candidate with zero failures and every skip reasoned.",
      "invocation": [
        "-m",
        "pytest",
        "-q"
      ],
      "skip_policy": "Skips are approved by identity, never by count: the recorded JUnit skip set must equal this approved list (nodeid exact, reason substring); any unknown, missing, replaced or unreasoned skip is unapproved. The runner writes the JUnit record into the gate evidence directory via PYTEST_ADDOPTS, keeping the executed argv identical to this invocation.",
      "approved_skips": [
        {
          "nodeid": "tests/test_adapter_conformance/AdapterConformanceTest.py::test_released_resot_route_passes_and_public_fixture_fails_only_c1",
          "reason_contains": "local normalized ReSOT inputs are not shipped"
        },
        {
          "nodeid": "tests/test_gate20_d7_trained_beam/Gate20TrainedBeamTest.py::test_remote_runner_contract_is_fail_closed_and_replicated",
          "reason_contains": "AutoDL orchestration is intentionally outside"
        },
        {
          "nodeid": "tests/test_gate21_tiger_d7_trace/Gate21TigerD7TraceTest.py::test_official_loader_fail_closed_stub_covers_unused_openpyxl_import",
          "reason_contains": "does not redistribute the DACT source checkout"
        },
        {
          "nodeid": "tests/test_gate21_tiger_d7_trace/Gate21TigerD7TraceTest.py::test_released_checkpoint_generation_closes_both_mode_contracts",
          "reason_contains": "released DACT assets are not present"
        },
        {
          "nodeid": "tests/test_gate21_tiger_d7_trace/Gate21TigerD7TraceTest.py::test_released_preprocessing_has_golden_parity",
          "reason_contains": "released DACT assets are not present"
        },
        {
          "nodeid": "tests/test_resot_same_dataset_control.py::test_frozen_resot_control_reports_all_prefix_depths",
          "reason_contains": "frozen ReSOT normalized inputs are not redistributed"
        }
      ]
    },
    {
      "gate_id": "release_metadata_verifier",
      "binding": "catalog_command",
      "description": "tools/verify_sidscope_release_metadata.py",
      "invocation": [
        "tools/verify_sidscope_release_metadata.py"
      ]
    },
    {
      "gate_id": "architecture_inventory_verifier",
      "binding": "catalog_command",
      "description": "tools/verify_sidscope_architecture_inventory.py",
      "invocation": [
        "tools/verify_sidscope_architecture_inventory.py"
      ]
    },
    {
      "gate_id": "sdlc_acceptance_verifier",
      "binding": "catalog_command",
      "description": "tools/verify_sidscope_sdlc_acceptance.py",
      "invocation": [
        "tools/verify_sidscope_sdlc_acceptance.py"
      ]
    },
    {
      "gate_id": "sdlc_hardening_engineering_ready",
      "binding": "catalog_command",
      "description": "tools/verify_sidscope_sdlc_hardening.py --require-engineering-ready",
      "invocation": [
        "tools/verify_sidscope_sdlc_hardening.py",
        "--require-engineering-ready"
      ]
    },
    {
      "gate_id": "release_profiles_verifier",
      "binding": "catalog_command",
      "description": "tools/verify_sidscope_release_profiles.py",
      "invocation": [
        "tools/verify_sidscope_release_profiles.py"
      ]
    },
    {
      "gate_id": "candidate_engineering_ready_clean",
      "binding": "catalog_command",
      "description": "tools/verify_sidscope_2_0_candidate.py --require-engineering-ready --require-clean",
      "invocation": [
        "tools/verify_sidscope_2_0_candidate.py",
        "--require-engineering-ready",
        "--require-clean"
      ]
    },
    {
      "gate_id": "resource_package_verifier",
      "binding": "catalog_command",
      "description": "tools/verify_sidscope_resource_package.py without skip options",
      "invocation": [
        "tools/verify_sidscope_resource_package.py"
      ]
    },
    {
      "gate_id": "performance_campaign",
      "binding": "campaign_receipt",
      "description": "Three fresh-process groups of the six frozen CPU commands; every group must satisfy the original threshold and the corrected environment policy."
    },
    {
      "gate_id": "exact_source_record_v2",
      "binding": "record_v2",
      "description": "Detached exact-source record v2 with verify passing for runtime, conformance and evidence-full archives."
    }
  ],
  "decision": {
    "decided_by": "project_owner",
    "date": "2026-10-08",
    "adr": "docs/adr/0027-defer-linux-support-beyond-2-0.md",
    "statement": "Exclude Linux Python 3.9-3.12 support and matrix execution from 2.0; revisit after user feedback."
  },
  "deferred_gates": [
    "linux_matrix"
  ],
  "platform_support": {
    "accepted": "macOS arm64 / CPython 3.9.6",
    "linux": "unsupported_in_2_0",
    "windows": "unverified"
  }
}
