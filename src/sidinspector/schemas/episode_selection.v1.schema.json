{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidscope.dev/schemas/episode_selection.v1.schema.json",
  "title": "SIDScope EpisodeSelection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_revision", "selection_id", "producer", "prepared_dataset_binding", "split", "policies", "rows", "content_sha256"],
  "properties": {
    "schema": {"const": "sidscope.episode_selection.v1"}, "schema_revision": {"const": "1.0.0"},
    "selection_id": {"type": "string", "minLength": 1}, "producer": {"type": "object"},
    "prepared_dataset_binding": {"type": "object"}, "split": {"type": "object"},
    "policies": {"type": "object"}, "rows": {"type": "array", "minItems": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
