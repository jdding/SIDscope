{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidscope.dev/schemas/evidence_index.v1.schema.json",
  "title": "SIDScope EvidenceIndex v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_revision", "evidence_index_id", "producer", "artifacts", "edges", "omissions", "privacy", "content_sha256"],
  "properties": {
    "schema": {"const": "sidscope.evidence_index.v1"}, "schema_revision": {"const": "1.0.0"},
    "evidence_index_id": {"type": "string", "minLength": 1}, "producer": {"type": "object"},
    "artifacts": {"type": "array", "minItems": 1}, "edges": {"type": "array"},
    "omissions": {"type": "array"}, "privacy": {"type": "object"},
    "content_sha256": {"type": "string"}
  }
}
