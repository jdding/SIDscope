{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jdding/sidscope/schemas/evidence_submission.v1.schema.json",
  "title": "SIDScope EvidenceSubmission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_revision",
    "submission_id",
    "producer",
    "artifacts",
    "claims",
    "content_sha256"
  ],
  "properties": {
    "schema": {"const": "sidscope.evidence_submission.v1"},
    "schema_revision": {"const": "1.0.0"},
    "submission_id": {"$ref": "#/$defs/identifier"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "role", "path", "sha256"],
        "properties": {
          "artifact_id": {"$ref": "#/$defs/identifier"},
          "role": {
            "enum": [
              "dataset_profile_descriptor",
              "profile_conformance_report",
              "evidence_bundle",
              "evidence_object"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_revision",
        "dataset_identity_sha256",
        "target_universe_sha256",
        "evaluation_cutoff",
        "publication_depth",
        "rank_semantics",
        "exact_ranks"
      ],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_revision": {"type": "string", "minLength": 1},
        "dataset_identity_sha256": {"$ref": "#/$defs/sha256"},
        "target_universe_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_cutoff": {"type": "integer", "minimum": 1},
        "publication_depth": {"type": "integer", "minimum": 1},
        "rank_semantics": {"enum": ["exact_with_censoring", "cutoff_only"]},
        "exact_ranks": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
