{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidscope.dev/schemas/dataset_profile_descriptor.v1.schema.json",
  "title": "SIDScope DatasetProfileDescriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_revision", "descriptor_id", "producer", "dataset_identity_sha256", "split_bindings", "catalog", "target_universe", "evaluation", "privacy", "content_sha256"],
  "properties": {
    "schema": {"const": "sidscope.dataset_profile_descriptor.v1"},
    "schema_revision": {"const": "1.0.0"},
    "descriptor_id": {"type": "string", "minLength": 1},
    "producer": {"$ref": "#/$defs/producer"},
    "dataset_identity_sha256": {"$ref": "#/$defs/sha256"},
    "split_bindings": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/split"}
    },
    "catalog": {"$ref": "#/$defs/universe"},
    "target_universe": {"$ref": "#/$defs/universe"},
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["cutoff", "publication_depth", "slices"],
      "properties": {
        "cutoff": {"type": "integer", "minimum": 1},
        "publication_depth": {"type": "integer", "minimum": 1},
        "slices": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["slice_id", "definition_sha256"],
            "properties": {"slice_id": {"type": "string", "minLength": 1}, "definition_sha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_sha256", "source_user_ids_exported", "source_item_ids_exported", "absolute_private_paths_exported"],
      "properties": {
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "source_user_ids_exported": {"const": false},
        "source_item_ids_exported": {"const": false},
        "absolute_private_paths_exported": {"const": false}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "split": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "content_sha256", "row_count"],
      "properties": {
        "role": {"enum": ["train", "validation", "test"]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 0}
      }
    },
    "universe": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "item_count", "content_sha256"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "item_count": {"type": "integer", "minimum": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
