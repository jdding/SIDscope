{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jdding/sidscope/schemas/contract_registry.v1.schema.json",
  "title": "SIDScope Contract Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_revision", "registry_id", "producer", "contracts", "content_sha256"],
  "properties": {
    "schema": {"const": "sidscope.contract_registry.v1"},
    "schema_revision": {"const": "1.0.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "producer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_type", "schema_id", "schema_revision", "owner", "schema_resource", "compatibility", "canonical_fixture", "negative_fixtures", "dependencies", "result_id_field"],
        "properties": {
          "contract_type": {"type": "string", "minLength": 1},
          "schema_id": {"type": "string", "pattern": "^sidscope\\.[A-Za-z0-9_.-]+\\.v[0-9]+$"},
          "schema_revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "owner": {"type": "string", "minLength": 1},
          "schema_resource": {"type": "string", "minLength": 1},
          "compatibility": {"type": "object", "additionalProperties": false, "required": ["policy", "supported_revisions"], "properties": {"policy": {"const": "exact_major_supported_revision"}, "supported_revisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}}},
          "canonical_fixture": {"type": "string", "minLength": 1},
          "negative_fixtures": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "expected_failure"], "properties": {"path": {"type": "string", "minLength": 1}, "expected_failure": {"type": "string", "minLength": 1}}}},
          "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["schema_id", "accepted_revisions"], "properties": {"schema_id": {"type": "string", "pattern": "^sidscope\\.[A-Za-z0-9_.-]+\\.v[0-9]+$"}, "accepted_revisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}}}},
          "result_id_field": {"type": "string", "minLength": 1}
        }
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
