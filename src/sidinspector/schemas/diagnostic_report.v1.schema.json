{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidscope.dev/schemas/diagnostic_report.v1.schema.json",
  "title": "SIDScope DiagnosticReport v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_revision", "diagnostic_report_id", "producer", "trace_binding", "episode_selection_binding", "evaluation", "failure_decomposition", "compute", "censoring", "slices", "content_sha256"],
  "properties": {
    "schema": {"const": "sidscope.diagnostic_report.v1"}, "schema_revision": {"const": "1.0.0"},
    "diagnostic_report_id": {"type": "string", "minLength": 1}, "producer": {"type": "object"},
    "trace_binding": {"type": "object"}, "episode_selection_binding": {"type": "object"},
    "evaluation": {"type": "object"}, "failure_decomposition": {"type": "object"},
    "compute": {"type": "object"}, "censoring": {"type": "object"},
    "slices": {"type": "array", "minItems": 1}, "content_sha256": {"type": "string"}
  }
}
