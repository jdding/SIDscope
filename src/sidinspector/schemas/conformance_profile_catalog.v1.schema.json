{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidscope.dev/schemas/conformance_profile_catalog.v1.schema.json",
  "title": "SIDScope ConformanceProfileCatalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_revision", "profiles", "content_sha256"],
  "properties": {
    "schema": {"const": "sidscope.conformance_profile_catalog.v1"},
    "schema_revision": {"const": "1.0.0"},
    "profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "revision", "profile_kind", "owner", "gates", "fixture", "lifecycle", "status_label_policy"],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "profile_kind": {"enum": ["static_mapping", "generator", "overlay", "release"]},
          "owner": {"type": "string", "minLength": 1},
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["gate_id", "owner", "depends_on", "failure_code"],
              "properties": {
                "gate_id": {"type": "string", "minLength": 1},
                "owner": {"type": "string", "minLength": 1},
                "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "failure_code": {"type": "string", "minLength": 1}
              }
            }
          },
          "fixture": {
            "type": "object", "additionalProperties": false,
            "required": ["positive", "negatives"],
            "properties": {
              "positive": {"type": "string", "minLength": 1},
              "negatives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
            }
          },
          "lifecycle": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "migration_policy", "deprecation_policy"],
            "properties": {
              "status": {"enum": ["active", "deprecated", "blocked"]},
              "migration_policy": {"type": "string", "minLength": 1},
              "deprecation_policy": {"type": "string", "minLength": 1}
            }
          },
          "status_label_policy": {
            "type": "object", "additionalProperties": false,
            "required": ["pass", "partial", "fail"],
            "properties": {
              "pass": {"type": "string", "minLength": 1},
              "partial": {"type": "string", "minLength": 1},
              "fail": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
