{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidscope.dev/schemas/profile_conformance_report.v1.schema.json",
  "title": "SIDScope ProfileConformanceReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_revision", "report_id", "producer", "profile_binding", "descriptor_binding", "artifacts", "gates", "decision", "content_sha256"],
  "properties": {
    "schema": {"const": "sidscope.profile_conformance_report.v1"},
    "schema_revision": {"const": "1.0.0"},
    "report_id": {"type": "string", "minLength": 1},
    "producer": {"$ref": "#/$defs/producer"},
    "profile_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_revision", "catalog_sha256"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_revision": {"type": "string", "minLength": 1},
        "catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "descriptor_binding": {"$ref": "#/$defs/binding"},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "role", "schema_id", "schema_revision", "content_sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "schema_id": {"type": "string", "minLength": 1},
          "schema_revision": {"type": "string", "minLength": 1},
          "content_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "status", "failure"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "partial", "fail"]},
          "failure": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["code", "detail"],
                "properties": {"code": {"type": "string", "minLength": 1}, "detail": {"type": "string", "minLength": 1}}
              }
            ]
          }
        }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "status_label"],
      "properties": {"status": {"enum": ["pass", "partial", "fail"]}, "status_label": {"type": "string", "minLength": 1}}
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "schema_revision", "content_sha256"],
      "properties": {"schema_id": {"type": "string", "minLength": 1}, "schema_revision": {"type": "string", "minLength": 1}, "content_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
